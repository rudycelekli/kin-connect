# Copy to .env. npm start and npm run dev load it; existing process variables win.
# Local installation needs no provider keys and stays bound to loopback.
PORT=4318
KIN_DATA_DIR=.data

# Public HTTPS deployment only. Set these in Railway Variables for the hosted service.
# KIN_PUBLIC_ORIGIN=https://www.kinconnections.com
# KIN_PUBLIC_ALIASES=https://kin-relay-production.up.railway.app
# KIN_ALLOWED_ORIGINS=https://rudycelekli.github.io,https://www.kinconnections.com,https://kin-relay-production.up.railway.app
# KIN_DATA_DIR=/data
# VITE_RELAY_URL=https://www.kinconnections.com

# Optional official verification: replace only with the exact portal-issued token.
# KIN_OPENAI_APPS_CHALLENGE=

# Server-only credentials. Intake stays OFF until explicitly enabled below.
# Filling keys alone enables no feature. Resend remains reserved/unconsumed.
# Never prefix a secret with VITE_, commit .env, or put keys in the plugin ZIP.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
RESEND_API_KEY=

# Optional local-only intake. The public relay ALWAYS disables it.
# Explicit owner approval is required for each selected text submission.
KIN_INTAKE_ENABLED=false
KIN_OPENAI_INTAKE_MODEL=
KIN_ANTHROPIC_INTAKE_MODEL=

# Operator metadata placeholders, not yet consumed or published by runtime code.
# Set real monitored addresses before publishing them. Resend is not an inbox.
KIN_OPERATOR_NAME=Gradia
KIN_SUPPORT_EMAIL=
KIN_PRIVACY_EMAIL=
KIN_ABUSE_EMAIL=
RESEND_FROM_EMAIL=
